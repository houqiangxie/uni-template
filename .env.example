# 复制为 .env / .env.development / .env.production 后按需填写
# cp .env.example .env

# 应用标题
VITE_APP_TITLE=Uni 模板

# API 根地址：小程序 / App 运行时使用；H5 开发时同时作为 vite proxy 目标
# H5 运行时仍取 window.location.origin
VITE_BASE_URL=https://api.example.com

# 请求路径前缀（拼在 base 后，如 /api）
VITE_API_PREFIX=/api

# 远程静态资源路径前缀（默认 /wxStaticFile/static）
VITE_STATIC_PREFIX=/wxStaticFile/static

# 微信小程序 appid（构建时可写入 manifest；也可直接改 src/manifest.json）
VITE_MP_WEIXIN_APPID=

# AES-128-ECB 密钥（登录密码等，须与后端约定一致，16 字节）
VITE_AES_KEY=

# RSA 公钥（PEM 主体，可含 \\n）
VITE_RSA_PUBLIC_KEY=
# 文件下载等企业端 RSA 公钥（可选，默认回退到 VITE_RSA_PUBLIC_KEY）
VITE_RSA_ENTERPRISE_PUBLIC_KEY=

# 高德地图 Key（构建时注入 manifest.json）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# 多语言：未设置时默认关闭；需要时设为 true
VITE_ENABLE_I18N=false

# 远程语言包版本，用于 ?v= 缓存刷新
VITE_LOCALE_REMOTE_VERSION=
