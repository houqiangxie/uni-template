{
  "globalStyle": {
    "navigationBarTitleText": "Uni 模板",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom",
    "navigationStyle": "custom"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index",
      "type": "home",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "首页",
        "showLeftButton": false
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "hideNavbar": true
      }
    }
  ],
  "preloadRule": {
    "pages/index": {
      "network": "all",
      "packages": [
        "pages-echarts",
        "pages-test"
      ]
    }
  },
  "__esModule": true,
  "subPackages": [
    {
      "root": "pages-echarts",
      "pages": [
        {
          "path": "ComChart",
          "type": "page"
        }
      ]
    },
    {
      "root": "pages-test",
      "pages": [
        {
          "path": "pages/form-demo/index",
          "type": "page",
          "layout": "default",
          "style": {
            "navigationBarTitleText": "表单示例"
          }
        }
      ]
    }
  ]
}