# 本地默认（勿提交真实内网地址与密钥，见 .env.example）
VITE_APP_TITLE=Uni 模板

# API 根地址：小程序 / App 运行时使用；H5 开发时同时作为 vite proxy 目标
VITE_BASE_URL=https://api.example.com
VITE_API_PREFIX=/api
VITE_STATIC_PREFIX=/wxStaticFile/static

VITE_AES_KEY=
VITE_RSA_PUBLIC_KEY=
VITE_RSA_ENTERPRISE_PUBLIC_KEY=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
VITE_MP_WEIXIN_APPID=

# 多语言：未设置时默认关闭；需要时在对应 .env.* 中设为 true
VITE_ENABLE_I18N=true
